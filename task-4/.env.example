# Environment variables for the ATC MCP Server
# ALL of the following are REQUIRED (Stage 4+).
# Copy this file to .env and set all values before running.
# The server will fail fast at startup if any value is missing or invalid.

# Path to the SQLite database file (relative to project root)
ATC_DB_PATH=./data/atc.db

# ── Airport capacity (REQUIRED) ─────────────────────────────────────────────
# Number of operational runways (1-based: runway 1, 2, 3...)
ATC_RUNWAY_COUNT=2

# Number of available gates (1-based: gate 1, 2, 3...)
ATC_GATE_COUNT=10

# Number of ground crew teams available simultaneously (1-based)
ATC_CREW_COUNT=4

# ── Separation buffers in minutes (REQUIRED) ────────────────────────────────
# Minimum gap between two consecutive arrivals on the same runway
ATC_SEP_ARRIVAL_ARRIVAL=3

# Minimum gap between two consecutive departures on the same runway
ATC_SEP_DEPARTURE_DEPARTURE=2

# Minimum gap when mixing arrival and departure (or departure then arrival)
ATC_SEP_MIXED=5

# ── Turnaround & buffer times in minutes (REQUIRED) ─────────────────────────
# Minimum gate occupancy time after an arrival before the gate is free
ATC_GATE_TURNAROUND=30

# Extra buffer added after a dependency's scheduled end before the dependent can start
ATC_DEPENDENCY_BUFFER=10

# ── Scheduling horizon (REQUIRED) ────────────────────────────────────────────
# Maximum minutes from "now" that a flight may be scheduled (hard limit)
ATC_SCHEDULE_HORIZON=480
